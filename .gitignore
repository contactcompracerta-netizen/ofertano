# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
debug-mercadolivre.html
log.txt
src/components/Header.tsx.backup

# ml affiliate: artefatos locais de execucao
# O perfil .ml-affiliate-chrome/ e scripts/.ml-affiliate-poc-logs/ eram
# gravados por scripts/ml-affiliate-poc.mts (POC superseded). O gerador real
# (src/services/affiliates/mercadolivre/generator.ts) conecta via CDP
# (127.0.0.1:9222) e nao cria perfil local.
.ml-affiliate-profile/
.ml-affiliate-chrome/
scripts/.ml-affiliate-poc-logs/
.ml-affiliate-daemon.lock

# Evidencia gerada por execucao de teste/rehearsal/canario.
# Regra: evidencia LIDA por gate, teste, runbook ou doc e fixture e fica
# versionada (ver docs/evidence/README.md). Saida reescrita a cada execucao
# nao e evidencia, e log.
/docs/evidence/50ag*/

# Banco local de rascunho (o datasource do projeto e PostgreSQL).
# O dev.db versionado continha 3 linhas Product da era "Compra Certa".
# O conteudo permanece no historico Git; nao e fixture de teste.
/dev.db
/dev.db-journal
/dev.db-shm
/dev.db-wal

# Prisma Client gerado.
# O schema usa `provider = "prisma-client-js"` SEM `output`, portanto
# `prisma generate` escreve em node_modules/@prisma/client. Este diretório
# existia apenas como artefato de uma configuração antiga de `output` e nunca
# foi importado pelo projeto. Não versionar.
/src/generated/prisma/
