  "policies": [
    {
      "tablename": "BlogPost",
      "policyname": "blog_post_public_read",
      "permissive": "PERMISSIVE",
      "roles": [
        "anon",
        "authenticated"
      ],
      "cmd": "SELECT",
      "qual": "((status = 'PUBLISHED'::\"BlogPostStatus\") AND (\"publishedAt\" <= now()))",
      "with_check": null
    },
