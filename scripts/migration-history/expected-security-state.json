      "qual": "((auth.uid())::text = \"userId\")",
      "with_check": "((auth.uid())::text = \"userId\")"
    },
    {
      "tablename": "Product",
      "policyname": "product_public_read",
      "permissive": "PERMISSIVE",
      "roles": [
        "anon",
        "authenticated"
      ],
      "cmd": "SELECT",
      "qual": "((active = true) AND (\"publicationStatus\" <> ALL (ARRAY['DRAFT'::\"ProductPublicationStatus\", 'ARCHIVED'::\"ProductPublicationStatus\"])) AND (price > (0)::double precision) AND (image IS NOT NULL) AND (image <> ''::text) AND (EXISTS ( SELECT 1\n   FROM \"MarketplaceOffer\" o\n  WHERE (o.\"productId\" = \"Product\".id)\n HAVING (count(DISTINCT o.marketplace) >= 2))))",
      "with_check": null
    }
