    {
      "tablename": "MarketplaceOffer",
      "policyname": "marketplace_offer_public_read",
      "permissive": "PERMISSIVE",
      "roles": [
        "anon",
        "authenticated"
      ],
      "cmd": "SELECT",
      "qual": "((active = true) AND (available = true) AND (\"matchStatus\" = 'EXACT'::\"ProductMatchStatus\") AND (status <> ALL (ARRAY['UNAVAILABLE'::\"MarketplaceOfferStatus\", 'ERROR'::\"MarketplaceOfferStatus\"])) AND (price > (0)::double precision))",
      "with_check": null
    },
