generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Marketplace {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
}

model Product {
  id             String   @id @default(uuid())
  mlId           String?  @unique
  name           String
  slug           String?  @unique
  image          String
  images         String[]
  video          String?
  brand          String?
  description    String?
  specifications Json?
  category       String
  store          String
  affiliateLink  String
  price          Float
  oldPrice       Float?
  installments   String?
  discount       Int?
  rating         Float?
  reviews        Int?
  sales          Int?
  stock          Int?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  offers MarketplaceOffer[]
}

model MarketplaceOffer {
  id            String      @id @default(cuid())

  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplace   Marketplace

  affiliateLink String

  price         Float
  oldPrice      Float?
  installments  String?
  stock         Int?

  active        Boolean     @default(true)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, marketplace])
}

model MarketplaceConnection {
  id           String      @id @default(cuid())

  marketplace  Marketplace @unique

  sellerId     String

  accessToken  String      @db.Text

  refreshToken String      @db.Text

  expiresAt    DateTime

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}