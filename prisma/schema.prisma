generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Marketplace {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  MAGAZINE_LUIZA
  CASAS_BAHIA
  KABUM
  TERABYTE
  ALIEXPRESS
  CARREFOUR
}

enum ProductPublicationStatus {
  DRAFT
  LIVE_PARTIAL
  LIVE_COMPLETE
  ARCHIVED
}

enum MarketplaceOfferStatus {
  DISCOVERED
  PENDING_AFFILIATE
  UNDER_REVIEW
  ACTIVE
  UNAVAILABLE
  ERROR
}

enum ProductMatchStatus {
  EXACT
  HIGH
  REVIEW
  REJECTED
}

enum DiscoverySource {
  MANUAL
  OPPORTUNITY
  ON_DEMAND_SEARCH
  PRICE_MONITOR
  API
}

enum SearchRequestStatus {
  PENDING
  SEARCHING
  PARTIAL
  COMPLETED
  NOT_FOUND
  ERROR
}

model Product {
  id String @id @default(uuid())

  // Campos atuais mantidos para não quebrar o site.
  mlId           String?  @unique
  name           String
  slug           String?  @unique
  image          String
  images         String[]
  video          String?
  brand          String?
  description    String?
  specifications Json?
  category       String
  store          String
  affiliateLink  String
  price          Float
  oldPrice       Float?
  installments   String?
  discount       Int?
  rating         Float?
  reviews        Int?
  sales          Int?
  stock          Int?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)

  // Identificação canônica usada para agrupar ofertas do mesmo produto.
  canonicalName String?
  canonicalKey  String? @unique
  modelNumber   String?
  ean           String?
  gtin          String?
  mpn           String?
  color         String?
  voltage       String?
  size          String?

  publicationStatus ProductPublicationStatus @default(LIVE_COMPLETE)

  autoCreated    Boolean   @default(false)
  sourceQuery    String?
  lastSearchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers         MarketplaceOffer[]
  priceHistory   PriceHistory[]     @relation("ProductPriceHistory")
  searchRequests SearchRequest[]
  favorites      Favorite[]
  priceAlerts    PriceAlert[]

  @@index([active, updatedAt])
  @@index([category, active])
  @@index([brand, modelNumber])
  @@index([publicationStatus, updatedAt])
}

model MarketplaceOffer {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplace Marketplace

  // Identificação da oferta dentro do marketplace.
  externalId String?
  sourceUrl  String? @db.Text

  // Pode ficar vazio enquanto aguarda revisão.
  affiliateLink String? @db.Text

  title  String?
  image  String?
  seller String?

  price        Float
  oldPrice     Float?
  installments String?
  stock        Int?

  status MarketplaceOfferStatus @default(ACTIVE)

  matchStatus ProductMatchStatus @default(HIGH)
  matchScore  Float?

  discoverySource DiscoverySource @default(MANUAL)

  active    Boolean @default(true)
  available Boolean @default(true)
  isBest    Boolean @default(false)

  reviewReason String? @db.Text
  errorMessage String? @db.Text

  affiliateValidatedAt DateTime?
  reviewedAt           DateTime?
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime?
  lastPriceChangeAt    DateTime?

  consecutiveErrors Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[] @relation("OfferPriceHistory")

  @@unique([productId, marketplace])
  @@unique([marketplace, externalId])
  @@index([status, updatedAt])
  @@index([matchStatus, updatedAt])
  @@index([nextCheckAt, active])
  @@index([productId, price])
}

model MarketplaceConnection {
  id String @id @default(cuid())

  marketplace Marketplace @unique

  sellerId String

  accessToken  String @db.Text
  refreshToken String @db.Text

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceHistory {
  id String @id @default(cuid())

  // Mantido para compatibilidade com o histórico atual.
  productId String
  product   Product @relation("ProductPriceHistory", fields: [productId], references: [id], onDelete: Cascade)

  // Identifica a oferta específica de cada loja.
  offerId String?
  offer   MarketplaceOffer? @relation("OfferPriceHistory", fields: [offerId], references: [id], onDelete: SetNull)

  marketplace Marketplace?

  price    Float
  oldPrice Float?

  source DiscoverySource?

  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@index([offerId, recordedAt])
  @@index([marketplace, recordedAt])
}

model SearchRequest {
  id String @id @default(cuid())

  query           String
  normalizedQuery String

  status SearchRequestStatus @default(PENDING)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  requesterKey String?

  attempts    Int @default(0)
  resultCount Int @default(0)

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  opportunities ProductOpportunity[]

  @@index([normalizedQuery, status])
  @@index([status, createdAt])
  @@index([productId, createdAt])
}

enum ImportQueueStatus {
  PENDING
  PROCESSING
  SUCCESS
  ERROR
}

model ImportQueue {
  id String @id @default(cuid())

  url         String            @unique
  marketplace Marketplace
  status      ImportQueueStatus @default(PENDING)

  attempts     Int     @default(0)
  errorMessage String?

  productId     String?
  affiliateLink String? @db.Text
  opportunityId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([marketplace, status])
}

enum OpportunitySourceType {
  PRODUCT
  ITEM
  USER_PRODUCT
  SEARCH_RESULT
}

enum OpportunityStatus {
  WAITING_AFFILIATE
  READY_TO_QUEUE
  QUEUED
  PUBLISHED
  DISMISSED
  ERROR
}

model ProductOpportunity {
  id String @id @default(cuid())

  marketplace Marketplace @default(MERCADO_LIVRE)

  // O código pode se repetir em marketplaces diferentes.
  externalId String

  sourceType OpportunitySourceType
  sourceUrl  String                @db.Text

  title String
  image String?

  categoryId   String?
  categoryName String?

  price    Float?
  oldPrice Float?
  discount Int?

  affiliateLink String? @db.Text

  status OpportunityStatus @default(WAITING_AFFILIATE)

  matchStatus ProductMatchStatus @default(HIGH)
  matchScore  Float?

  reviewReason String? @db.Text

  attempts     Int     @default(0)
  errorMessage String? @db.Text

  productId String?

  searchRequestId String?
  searchRequest   SearchRequest? @relation(fields: [searchRequestId], references: [id], onDelete: SetNull)

  discoveredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  queuedAt     DateTime?
  publishedAt  DateTime?

  @@unique([marketplace, externalId])
  @@index([status, discoveredAt])
  @@index([categoryId, discoveredAt])
  @@index([marketplace, status, discoveredAt])
  @@index([searchRequestId, discoveredAt])
  @@index([matchStatus, discoveredAt])
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id String @id @default(cuid())

  slug     String @unique
  title    String
  excerpt  String @db.Text
  category String
  author   String @default("Ofertano")

  readingTime String @default("5 min de leitura")
  theme       String @default("emerald")
  coverImage  String? @db.Text

  sections Json

  status   BlogPostStatus @default(DRAFT)
  featured Boolean        @default(false)

  seoTitle       String?
  seoDescription String? @db.Text
  socialCaption  String? @db.Text

  scheduledAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([featured, status])
}

model Favorite {
  id String @id @default(uuid())

  userId String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

enum PriceAlertType {
  ANY_DROP
  TARGET_PRICE
}

model PriceAlert {
  id String @id @default(uuid())

  userId String

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         PriceAlertType
  targetPrice  Float?
  referencePrice Float?

  active Boolean @default(true)
  armed  Boolean @default(true)

  lastEvaluatedAt       DateTime?
  lastEvaluatedPrice    Float?
  lastEvaluatedHadExact Boolean?

  lastTriggeredAt    DateTime?
  lastTriggeredPrice Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PriceAlertEvent[]

  @@unique([userId, productId, type])
  @@index([userId, createdAt])
  @@index([productId])
  @@index([active, updatedAt])
}

model PriceAlertEvent {
  id String @id @default(uuid())

  alertId String
  alert   PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  type                   PriceAlertType
  price                  Float
  previousReferencePrice Float?
  targetPrice            Float?

  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
}
