generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Marketplace {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  MAGAZINE_LUIZA
  CASAS_BAHIA
  KABUM
  TERABYTE
  ALIEXPRESS
  CARREFOUR
}

enum ProductPublicationStatus {
  DRAFT
  LIVE_PARTIAL
  LIVE_COMPLETE
  ARCHIVED
}

enum MarketplaceOfferStatus {
  DISCOVERED
  PENDING_AFFILIATE
  UNDER_REVIEW
  ACTIVE
  UNAVAILABLE
  ERROR
}

enum ProductMatchStatus {
  EXACT
  HIGH
  REVIEW
  REJECTED
}

enum DiscoverySource {
  MANUAL
  OPPORTUNITY
  ON_DEMAND_SEARCH
  PRICE_MONITOR
  API
}

enum PriceAlertType {
  ANY_DROP
  TARGET
}

enum SearchRequestStatus {
  PENDING
  SEARCHING
  PARTIAL
  COMPLETED
  NOT_FOUND
  ERROR
}

enum RawListingStatus {
  DISCOVERED
  NORMALIZED
  MATCHED
  UNMATCHED
  STALE
  ARCHIVED
  ERROR
}

model Product {
  productIdentifiers ProductIdentifier[]
  productVariants ProductVariant[]
  identityEvidences IdentityEvidence[]
  identityConflictAsProductA IdentityConflict[] @relation("ConflictProductA")
  identityConflictAsProductB IdentityConflict[] @relation("ConflictProductB")
  offerObservations OfferObservation[]
  trustSignals TrustSignal[]
  productRelationAsFromProduct ProductRelation[] @relation("RelationFrom")
  productRelationAsToProduct ProductRelation[] @relation("RelationTo")
  id String @id @default(uuid())

  // Campos atuais mantidos para não quebrar o site.
  mlId           String?  @unique
  name           String
  slug           String?  @unique
  image          String
  images         String[]
  video          String?
  brand          String?
  description    String?
  specifications Json?
  category       String
  store          String
  affiliateLink  String
  price          Float
  oldPrice       Float?
  installments   String?
  discount       Int?
  rating         Float?
  reviews        Int?
  sales          Int?
  stock          Int?
  active         Boolean  @default(true)
  featured       Boolean  @default(false)

  // Identificação canônica usada para agrupar ofertas do mesmo produto.
  canonicalName String?
  canonicalKey  String? @unique
  modelNumber   String?
  ean           String?
  gtin          String?
  mpn           String?
  color         String?
  voltage       String?
  size          String?

  publicationStatus ProductPublicationStatus @default(LIVE_COMPLETE)

  autoCreated    Boolean   @default(false)
  sourceQuery    String?
  lastSearchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers         MarketplaceOffer[]
  rawMarketplaceListings RawMarketplaceListing[] @relation("ProductRawMarketplaceListings")
  priceHistory   PriceHistory[]     @relation("ProductPriceHistory")
  searchRequests SearchRequest[]
  priceAlerts    PriceAlert[]
  socialPosts    SocialPost[]

  @@index([active, updatedAt])
  @@index([category, active])
  @@index([brand, modelNumber])
  @@index([publicationStatus, updatedAt])
}

model RawMarketplaceListing {
  identityEvidences IdentityEvidence[]
  offerObservations OfferObservation[]
  trustSignals TrustSignal[]
  id String @id @default(cuid())

  marketplace Marketplace
  externalId  String

  sellerId   String?
  sellerName String?

  sourceUrl     String? @db.Text
  affiliateLink String? @db.Text

  title           String?
  normalizedTitle String?
  brand           String?
  modelNumber     String?
  ean             String?
  gtin            String?
  mpn             String?
  category        String?

  attributes Json?
  rawPayload Json?

  image    String?
  price    Float?
  oldPrice Float?
  stock    Int?

  available   Boolean          @default(true)
  active      Boolean          @default(true)
  status      RawListingStatus @default(DISCOVERED)
  fingerprint String?

  // CATALOG_ARCHITECTURE_V1 (aditivo, FASE G/I):
  //   catalogHash   => mudanças estruturais (título/marca/modelo/GTIN/variante).
  //   offerHash     => estado comercial (preço/estoque/disponibilidade).
  //   payloadVersion=> versão do schema do payload bruto (reprocessamento).
  catalogHash    String?
  offerHash      String?
  payloadVersion String?

  canonicalProductId String?
  canonicalProduct   Product? @relation("ProductRawMarketplaceListings", fields: [canonicalProductId], references: [id], onDelete: SetNull)

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([marketplace, externalId])
  @@index([canonicalProductId, updatedAt])
  @@index([marketplace, active])
  @@index([lastCheckedAt])
  @@index([brand, modelNumber])
  @@index([fingerprint])
}

model MarketplaceOffer {
  offerObservations OfferObservation[]
  trustSignals TrustSignal[]
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketplace Marketplace

  // Identificação da oferta dentro do marketplace.
  externalId String?
  sourceUrl  String? @db.Text

  // Pode ficar vazio enquanto aguarda revisão.
  affiliateLink String? @db.Text

  title  String?
  image  String?
  seller String?

  price        Float
  oldPrice     Float?
  installments String?
  stock        Int?

  status MarketplaceOfferStatus @default(ACTIVE)

  matchStatus ProductMatchStatus @default(HIGH)
  matchScore  Float?

  discoverySource DiscoverySource @default(MANUAL)

  active    Boolean @default(true)
  available Boolean @default(true)
  isBest    Boolean @default(false)

  reviewReason String? @db.Text
  errorMessage String? @db.Text

  affiliateValidatedAt DateTime?
  reviewedAt           DateTime?
  lastCheckedAt        DateTime?
  nextCheckAt          DateTime?
  lastPriceChangeAt    DateTime?

  consecutiveErrors Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[] @relation("OfferPriceHistory")

  @@unique([productId, marketplace])
  @@unique([marketplace, externalId])
  @@index([status, updatedAt])
  @@index([matchStatus, updatedAt])
  @@index([nextCheckAt, active])
  @@index([productId, price])
}

model MarketplaceConnection {
  id String @id @default(cuid())

  marketplace Marketplace @unique

  sellerId String

  accessToken  String @db.Text
  refreshToken String @db.Text

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceHistory {
  id String @id @default(cuid())

  // Mantido para compatibilidade com o histórico atual.
  productId String
  product   Product @relation("ProductPriceHistory", fields: [productId], references: [id], onDelete: Cascade)

  // Identifica a oferta específica de cada loja.
  offerId String?
  offer   MarketplaceOffer? @relation("OfferPriceHistory", fields: [offerId], references: [id], onDelete: SetNull)

  marketplace Marketplace?

  price    Float
  oldPrice Float?

  source DiscoverySource?

  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@index([offerId, recordedAt])
  @@index([marketplace, recordedAt])
}

// Alerta de preco criado por um usuario. Mantem compatibilidade com a
// tabela `price_alerts` que o frontend ja usava via Supabase, adicionando
// regras e dedupe por canal. userId referencia auth.users do Supabase e
// NAO possui FK (nao ha tabela de usuarios no schema Prisma).
model PriceAlert {
  id        String  @id @default(cuid())
  userId    String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  alertType       PriceAlertType @default(ANY_DROP)
  targetPrice     Float?
  // Menor preco ja observado pelo monitor, usado como referencia de baixa.
  referencePrice  Float
  lowestSeenPrice Float?
  // Queda minima percentual (0-100) exigida para disparo, quando definida.
  percentageDrop  Float?

  active Boolean @default(true)

  // Canais de notificacao. Whatsapp so fica true quando ha provider real.
  notifyEmail    Boolean @default(true)
  notifyWhatsApp Boolean @default(false)

  // Dedupe/cooldown por canal: evita reenviar o mesmo alerta.
  lastEmailNotifiedPrice    Float?
  lastEmailNotifiedAt       DateTime?
  lastWhatsAppNotifiedPrice Float?
  lastWhatsAppNotifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, active])
  @@index([active, updatedAt])
}

model SearchRequest {
  id String @id @default(cuid())

  query           String
  normalizedQuery String

  status SearchRequestStatus @default(PENDING)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  requesterKey String?

  attempts    Int @default(0)
  resultCount Int @default(0)

  errorMessage String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  opportunities ProductOpportunity[]

  @@index([normalizedQuery, status])
  @@index([status, createdAt])
  @@index([productId, createdAt])
}

enum ImportQueueStatus {
  PENDING
  PROCESSING
  SUCCESS
  ERROR
}

// CATALOG_ARCHITECTURE_V1 — Import Run / Batch (FASE J/K).
// Registra execuções de ingestão para grandes volumes e permite a
// reconciliação por FULL SNAPSHOT com grace period (nunca marcar
// indisponível no meio de importação incompleta).
enum ImportRunMode {
  FULL_SNAPSHOT
  INCREMENTAL
  REPROCESS
}

enum ImportRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ImportQueue {
  id String @id @default(cuid())

  url         String            @unique
  marketplace Marketplace
  status      ImportQueueStatus @default(PENDING)

  attempts     Int     @default(0)
  errorMessage String?

  productId     String?
  affiliateLink String? @db.Text
  opportunityId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([marketplace, status])
}

// CATALOG_ARCHITECTURE_V1 — ImportRun registra uma execução de ingestão:
// fonte, marketplaceId canônico (string — nunca nome), modo, status e totais.
model ImportRun {
  id String @id @default(cuid())

  source String
  // marketplaceId canônico da Architecture V1 (string). null => run agregado.
  marketplaceId String?
  mode ImportRunMode
  status ImportRunStatus @default(RUNNING)

  startedAt DateTime @default(now())
  finishedAt DateTime?

  itemsReceived  Int @default(0)
  itemsChanged   Int @default(0)
  itemsUnchanged Int @default(0)
  itemsRejected  Int @default(0)
  itemsFailed    Int @default(0)

  // Marcador de snapshot (último item visto) para reconciliação (FASE K).
  lastSeenAt DateTime?
  gracePeriodMinutes Int @default(1440)
  cursor String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches ImportBatch[]

  @@index([source, marketplaceId, startedAt])
  @@index([status, startedAt])
}

// Subdivisão operacional de um ImportRun (FASE J).
model ImportBatch {
  id String @id @default(cuid())

  runId String
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  index Int
  status ImportBatchStatus @default(PENDING)

  cursorStart String?
  cursorEnd String?

  itemsReceived  Int @default(0)
  itemsChanged   Int @default(0)
  itemsUnchanged Int @default(0)
  itemsRejected  Int @default(0)
  itemsFailed    Int @default(0)

  startedAt DateTime @default(now())
  finishedAt DateTime?
  lastSeenAt DateTime?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, index])
  @@index([status, startedAt])
}

enum OpportunitySourceType {
  PRODUCT
  ITEM
  USER_PRODUCT
  SEARCH_RESULT
}

enum OpportunityStatus {
  WAITING_AFFILIATE
  READY_TO_QUEUE
  QUEUED
  PUBLISHED
  DISMISSED
  ERROR
}

model ProductOpportunity {
  id String @id @default(cuid())

  marketplace Marketplace @default(MERCADO_LIVRE)

  // O código pode se repetir em marketplaces diferentes.
  externalId String

  sourceType OpportunitySourceType
  sourceUrl  String                @db.Text

  title String
  image String?

  categoryId   String?
  categoryName String?

  price    Float?
  oldPrice Float?
  discount Int?

  affiliateLink String? @db.Text

  status OpportunityStatus @default(WAITING_AFFILIATE)

  matchStatus ProductMatchStatus @default(HIGH)
  matchScore  Float?

  reviewReason String? @db.Text

  attempts     Int     @default(0)
  errorMessage String? @db.Text

  productId String?

  searchRequestId String?
  searchRequest   SearchRequest? @relation(fields: [searchRequestId], references: [id], onDelete: SetNull)

  discoveredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  queuedAt     DateTime?
  publishedAt  DateTime?

  @@unique([marketplace, externalId])
  @@index([status, discoveredAt])
  @@index([categoryId, discoveredAt])
  @@index([marketplace, status, discoveredAt])
  @@index([searchRequestId, discoveredAt])
  @@index([matchStatus, discoveredAt])
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SocialPostType {
  DUEL_PRICE
  FOUND_DEAL
  PRICE_COMPARISON
  SAVING_TIP
  ENGAGEMENT_QUESTION
  SHOPPING_CURIOSITY
}

enum SocialPostStatus {
  READY
  PUBLISHED
  ARCHIVED
}

enum SocialPostSlot {
  MORNING
  AFTERNOON
  EVENING
}

model SocialPost {
  id String @id @default(cuid())

  dayKey String
  slot   SocialPostSlot

  type   SocialPostType
  status SocialPostStatus @default(READY)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  caption  String @db.Text
  hashtags String[]
  data     Json

  fingerprint String

  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@unique([dayKey, slot])
  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@index([fingerprint])
}

model BlogPost {
  id String @id @default(cuid())

  slug     String @unique
  title    String
  excerpt  String @db.Text
  category String
  author   String @default("Ofertano")

  readingTime String @default("5 min de leitura")
  theme       String @default("emerald")
  coverImage  String? @db.Text

  sections Json

  status   BlogPostStatus @default(DRAFT)
  featured Boolean        @default(false)

  seoTitle       String?
  seoDescription String? @db.Text
  socialCaption  String? @db.Text

  scheduledAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([featured, status])
}

// Eventos first-party do painel de inteligência.
// eventType é String (não enum) para aceitar tipos futuros sem migration.
model AnalyticsEvent {
  id String @id @default(cuid())

  eventType String
  sessionId String

  productId   String?
  query       String?
  marketplace String?
  position    Int?
  resultCount Int?

  source      String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  deviceType  String?

  eventHash String @unique
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([productId, createdAt])
  @@index([query, createdAt])
  @@index([marketplace, createdAt])
  @@index([sessionId, createdAt])
}

// Agregação diária para o Admin não varrer eventos brutos.
model AnalyticsDailyAgg {
  id String @id @default(cuid())

  day          DateTime @db.Date
  grain        String
  eventType    String
  dimensionKey String

  query       String?
  productId   String?
  marketplace String?
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  deviceType  String?

  eventCount     Int @default(0)
  resultCountSum Int @default(0)

  lastEventAt DateTime @default(now())

  @@unique([day, grain, eventType, dimensionKey])
  @@index([grain, eventType, day])
  @@index([productId, day])
  @@index([query, day])
  @@index([marketplace, day])
  @@index([source, day])
  @@index([deviceType, day])
}

// Sessões anônimas por dia (visitantes).
model AnalyticsSessionDay {
  id String @id @default(cuid())

  sessionId String
  day       DateTime @db.Date

  source      String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  deviceType  String?

  createdAt DateTime @default(now())

  @@unique([sessionId, day])
  @@index([day])
  @@index([source, day])
  @@index([deviceType, day])
  @@index([utmSource, utmMedium, utmCampaign, day])
}

// Subscriptions Web Push do Admin. A chave VAPID privada nunca entra aqui.
model AdminPushSubscription {
  id        String @id @default(cuid())
  endpoint  String @unique @db.Text
  p256dh    String
  auth      String
  userAgent String? @db.Text

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
}

// Evita reenviar a mesma notificação para a mesma oportunidade.
model AdminPushDispatch {
  id             String   @id @default(cuid())
  opportunityKey String   @unique
  sentAt         DateTime @default(now())

  @@index([sentAt])
}

enum ProductIdentifierType {
  GTIN
  EAN
  UPC
  ISBN
  MPN
  MODEL
  BRAND_SKU
  MARKETPLACE_EXTERNAL_ID
}

enum IdentityConfidence {
  EXACT
  HIGH
  MEDIUM
  LOW
  MANUAL
}

enum IdentityEvidenceKind {
  IDENTIFIER_MATCH
  BRAND_MATCH
  MODEL_MATCH
  TITLE_MATCH
  ATTRIBUTE_MATCH
  MARKETPLACE_LINK
  MANUAL_ASSERTION
}

enum PriceComponentType {
  LIST_PRICE
  SALE_PRICE
  SHIPPING
  COUPON
  PIX_DISCOUNT
  MEMBERSHIP_PRICE
  INSTALLMENT_TOTAL
  FINAL_EFFECTIVE_PRICE
}

enum PriceTruthState {
  EXACT
  ESTIMATED
  PARTIAL
  UNKNOWN
}

enum IdentityConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TrustScopeType {
  PRODUCT
  RAW_LISTING
  OFFER_OBSERVATION
  MARKETPLACE_OFFER
}

enum TrustSignalState {
  CONFIRMED
  REJECTED
  UNKNOWN
}

enum ProductRelationType {
  COMPATIBLE
  SUBSTITUTE
  ACCESSORY
  BUNDLE
  SAME_FAMILY
  SUCCESSOR
  PREDECESSOR
}

model ProductIdentifier {
  conflicts IdentityConflict[]
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  type ProductIdentifierType
  value String
  normalizedValue String
  marketplace Marketplace?
  brandScope String?
  source String
  confidence IdentityConfidence
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, normalizedValue, brandScope])
  @@index([productId])
  @@index([variantId])
  @@index([marketplace, normalizedValue])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variantKey String
  name String?
  color String?
  size String?
  voltage String?
  capacity String?
  storage String?
  memory String?
  modelNumber String?
  attributes Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identifiers ProductIdentifier[]
  evidence IdentityEvidence[]
  observations OfferObservation[]
  @@unique([productId, variantKey])
}

model IdentityEvidence {
  id String @id @default(cuid())
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rawListingId String?
  rawListing RawMarketplaceListing? @relation(fields: [rawListingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  kind IdentityEvidenceKind
  rawEvidence Json
  confidence IdentityConfidence
  source String
  createdAt DateTime @default(now())
  conflicts IdentityConflict[]
  @@index([productId, createdAt])
  @@index([variantId])
  @@index([rawListingId, createdAt])
}

model IdentityConflict {
  id String @id @default(cuid())
  productAId String?
  productA Product? @relation("ConflictProductA", fields: [productAId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productBId String?
  productB Product? @relation("ConflictProductB", fields: [productBId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  identifierId String?
  identifier ProductIdentifier? @relation(fields: [identifierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  evidenceId String?
  evidence IdentityEvidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reason String
  status IdentityConflictStatus @default(OPEN)
  details Json
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([status, createdAt])
  @@index([productAId])
  @@index([productBId])
  @@index([identifierId])
  @@index([evidenceId])
}

model OfferObservation {
  id String @id @default(cuid())
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rawListingId String?
  rawListing RawMarketplaceListing? @relation(fields: [rawListingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  marketplaceOfferId String?
  marketplaceOffer MarketplaceOffer? @relation(fields: [marketplaceOfferId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  marketplace Marketplace
  externalId String
  sellerId String?
  sellerName String?
  sourceUrl String? @db.Text
  affiliateLink String? @db.Text
  title String?
  price Decimal? @db.Decimal(20, 6)
  oldPrice Decimal? @db.Decimal(20, 6)
  currency String @default("BRL")
  stock Int?
  available Boolean?
  capturedAt DateTime
  fingerprint String
  provenance Json
  createdAt DateTime @default(now())
  components OfferPriceComponent[]
  trustSignals TrustSignal[]
  @@unique([marketplace, externalId, fingerprint])
  @@index([productId, capturedAt])
  @@index([variantId, capturedAt])
  @@index([rawListingId, capturedAt])
  @@index([marketplaceOfferId, capturedAt])
  @@index([marketplace, externalId, capturedAt])
}

model OfferPriceComponent {
  id String @id @default(cuid())
  observationId String
  observation OfferObservation @relation(fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  type PriceComponentType
  amount Decimal? @db.Decimal(20, 6)
  currency String
  truthState PriceTruthState
  conditions Json?
  source String
  createdAt DateTime @default(now())
  @@index([observationId])
}

model TrustSignal {
  id String @id @default(cuid())
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rawListingId String?
  rawListing RawMarketplaceListing? @relation(fields: [rawListingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  observationId String?
  observation OfferObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  marketplaceOfferId String?
  marketplaceOffer MarketplaceOffer? @relation(fields: [marketplaceOfferId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scopeType TrustScopeType
  scopeId String
  signalType String
  state TrustSignalState
  value Json?
  source String
  evidence Json
  observedAt DateTime
  createdAt DateTime @default(now())
  @@index([scopeType, scopeId, signalType, observedAt])
  @@index([productId])
  @@index([rawListingId])
  @@index([observationId])
  @@index([marketplaceOfferId])
}

model ProductRelation {
  id String @id @default(cuid())
  fromProductId String
  fromProduct Product @relation("RelationFrom", fields: [fromProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toProductId String
  toProduct Product @relation("RelationTo", fields: [toProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relationType ProductRelationType
  confidence IdentityConfidence
  source String
  evidence Json
  createdAt DateTime @default(now())
  @@index([fromProductId, relationType])
  @@index([toProductId, relationType])
}

enum CommerceCanaryGrantStatus {
  ARMED
  CLAIMED
  CONSUMED
  FAILED
  EXPIRED
  DISABLED
}

enum CommerceCanaryAttemptKind {
  CLAIM
  BLOCKED
  CONSUMED
  FAILED
  EXPIRE
  DISABLE
}

// Distributed canary ONE-SHOT authorization (50AG.3 control plane).
// The database is the global authority: at most one authorized canary attempt
// across processes/instances. tokenHash is SHA-256 of the runtime token; the
// plaintext token is never persisted and never leaves the runtime environment.
model CommerceCanaryGrant {
  id                   String                    @id @default(cuid())
  tokenHash            String                    @unique
  status               CommerceCanaryGrantStatus @default(ARMED)
  marketplace          Marketplace
  externalId           String
  maxAttempts          Int                       @default(1)
  attemptsClaimed      Int                       @default(0)
  dryRunOnly           Boolean                   @default(false)
  requireExactIdentity Boolean                   @default(true)
  expiresAt            DateTime
  claimedAt            DateTime?
  claimedBy            String?
  consumedAt           DateTime?
  failedAt             DateTime?
  failureCode          String?
  resultObservationId  String?
  resultStatus         String?
  metadata             Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  attempts             CommerceCanaryAttempt[]

  @@index([status, expiresAt])
  @@index([marketplace, externalId])
}

// Append-only audit trail bound to the grant (control plane internal FK only).
// Bounded because maxAttempts=1 in Production design. Never stores secrets.
model CommerceCanaryAttempt {
  id          String                     @id @default(cuid())
  grantId     String
  grant       CommerceCanaryGrant        @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kind        CommerceCanaryAttemptKind
  reason      String?
  executionId String?
  latencyMs   Int?
  metadata    Json?
  createdAt   DateTime                   @default(now())

  @@index([grantId, createdAt])
  @@index([kind, createdAt])
}
